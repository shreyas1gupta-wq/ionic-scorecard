    },
    "social_endorsement_closers": {
      "severity": "P1",
      "flag_at": 1,
      "items": ["worth your time", "must-read", "won't want to miss this", "save this for later",
        "bookmark this", "don't sleep on this one", "thank me later"]
    },
    "emotional_flatline": {
      "severity": "P1",
      "flag_at": 1,
      "items": ["what surprised me most", "i was fascinated to discover", "what struck me was",
        "i was excited to learn", "the most interesting part", "hit differently", "hits different"]
    },
    "rhetorical_question_openers": {
      "severity": "P1",
      "flag_at": 1,
      "items": ["but what does this mean for", "so why should you care", "what's next?"]
