  "structural_checks": {
    "em_dash_hard_cap_per_1000_words": 1,
    "em_dash_target": 0,
    "rule_of_three_regex": "\\b(\\w+(?:,\\s+\\w+){1}(?:,)?\\s+and\\s+\\w+)\\b",
    "negation_pivot_regex": "\\bit'?s not\\b.{0,60}\\bit'?s\\b",
    "bullet_bare_noun_min_items": 5
  },
  "house_positive_checks": {
    "citation_regex": "([A-Za-z0-9_./\\\\-]+\\.(md|csv|parquet|py|xlsx|docx|json)(:[0-9]+)?)|(\\bas of \\d{4}-\\d{2}-\\d{2}\\b)|(\\bsource:\\s)",
    "note": "house rule -- flags paragraphs that assert a number/claim with no nearby file-path or as-of-date citation. Heuristic, not exhaustive: a paragraph is 'claim-bearing' if it contains a digit."
  }
