    "hollow_intensifiers": {
      "severity": "P1",
      "flag_at": 1,
      "items": ["genuine", "genuinely", "quite frankly", "to be honest", "let's be clear"]
    },
    "vague_endorsement": {
      "severity": "P2",
      "flag_at": 1,
      "items": ["worth reading", "worth paying attention to", "worth a look", "worth exploring",
        "worth checking out"]
    },
    "hedging_words": {
      "severity": "P2",
      "flag_at": 1,
      "items": ["perhaps", "could potentially", "it's important to note that", "to be clear"]
    },
    "confidence_calibration": {
      "severity": "P2",
      "flag_at": 1,
      "items": ["interestingly", "surprisingly", "importantly", "significantly", "notably",
        "certainly", "undoubtedly", "without a doubt"]
    },
    "persuasive_authority_tropes": {
      "severity": "P1",
      "flag_at": 1,
      "items": ["the real question is", "at its core", "fundamentally", "make no mistake",
