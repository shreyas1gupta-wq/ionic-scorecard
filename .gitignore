# Deck kit: generated client output never enters git
ionic-deck-kit/out/

# Deck-kit demo fixtures. Synthetic, no real client, published so the kit can be tested end to end.
# Note the _DEMO suffix on the score pattern: a REAL score file, named without it, stays ignored by
# the blanket *.csv rule above. Publishing live calls has to be a deliberate act, not a filename away.
!ionic-deck-kit/scores/ionic_scores_*_DEMO.csv
!ionic-deck-kit/fixtures/demo_statement.xlsx

# The production VERSION.json travels with the real score file and is never committed; the
# tracked VERSION_DEMO.json is what a fresh clone falls back to.
ionic-deck-kit/scores/VERSION.json

